# 应用
APP_NAME=NetDevTool API
APP_ENV=local
DEBUG=true

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=netdev

# Redis（Celery 消息队列；任务状态统一存 MySQL）
REDIS_URL=redis://127.0.0.1:6379/0

# 知识库目录与向量库
# KNOWLEDGE_BASE_DIR=
# 留空 QDRANT_URL 时使用嵌入式本地存储；接入服务端时填写 http://127.0.0.1:6333
QDRANT_URL=
QDRANT_API_KEY=
# QDRANT_LOCAL_PATH=

# 向量模型（留空时使用本地哈希向量）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIM=384

# Rerank 模型（BASE_URL 可填写服务根地址或完整 /rerank 地址）
RERANK_API_KEY=
RERANK_BASE_URL=
RERANK_MODEL=bge-reranker-v2-m3
RERANK_TIMEOUT=30

# 大模型（app/llm 使用）
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# 智能问答：回答模型（留空沿用 LLM_MODEL）
CHAT_QA_MODEL=
# 智能问答：意图识别模型，建议配小模型降低首字延迟（留空沿用 CHAT_QA_MODEL/LLM_MODEL）
CHAT_INTENT_MODEL=
# 问答生成整体时间预算（秒），含限流/超时重试，超预算直接失败
LLM_QA_BUDGET_SECONDS=60
# AI 调用记录保留天数，超期由 Celery beat 每日 03:30 清理
AI_RUN_RETENTION_DAYS=30

# 跨域（逗号分隔，与前端 dev server 端口保持一致）
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
