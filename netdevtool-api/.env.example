# 应用
APP_NAME=NetDevTool API
APP_ENV=local
DEBUG=true

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=netdev

# Redis（Celery 消息队列；任务状态统一存 MySQL）
REDIS_URL=redis://127.0.0.1:6379/0

# 知识库目录与向量库
# KNOWLEDGE_BASE_DIR=
# 留空 QDRANT_URL 时使用嵌入式本地存储；接入服务端时填写 http://127.0.0.1:6333
QDRANT_URL=
QDRANT_API_KEY=
# QDRANT_LOCAL_PATH=

# 向量模型（留空时使用本地哈希向量）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIM=384

# 大模型（app/llm 使用）
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 跨域（逗号分隔，与前端 dev server 端口保持一致）
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
