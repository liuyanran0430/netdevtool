{
  "openapi": "3.1.0",
  "info": {
    "title": "NetDevTool API",
    "description": "NetDevTool 后端接口，前后端以 OpenAPI 契约为准。",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "健康检查",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "登录",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "获取当前登录用户",
        "operationId": "get_me_api_v1_auth_me_get",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "退出登录",
        "operationId": "logout_api_v1_auth_logout_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/devices": {
      "get": {
        "tags": [
          "devices"
        ],
        "summary": "查询设备列表",
        "operationId": "get_devices_api_v1_devices_get",
        "parameters": [
          {
            "name": "vendor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "设备厂商，精确匹配",
              "title": "Vendor"
            },
            "description": "设备厂商，精确匹配"
          },
          {
            "name": "device_type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/DeviceType"
                },
                {
                  "type": "null"
                }
              ],
              "description": "设备类型：switch=交换机，firewall=防火墙",
              "title": "Device Type"
            },
            "description": "设备类型：switch=交换机，firewall=防火墙"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DeviceOut"
                  },
                  "title": "Response Get Devices Api V1 Devices Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/translations": {
      "post": {
        "tags": [
          "translations"
        ],
        "summary": "创建异步翻译任务",
        "operationId": "create_translation_api_v1_translations_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TranslationCreate"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranslationCreated"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "translations"
        ],
        "summary": "查询当前用户最近的翻译任务",
        "operationId": "list_translations_api_v1_translations_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TranslationListItem"
                  },
                  "title": "Response List Translations Api V1 Translations Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/translations/{request_id}": {
      "get": {
        "tags": [
          "translations"
        ],
        "summary": "查询翻译任务状态与结果",
        "operationId": "get_translation_api_v1_translations__request_id__get",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Request Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranslationOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "translations"
        ],
        "summary": "取消翻译任务",
        "operationId": "cancel_translation_api_v1_translations__request_id__delete",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Request Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/translations/{request_id}/source": {
      "get": {
        "tags": [
          "translations"
        ],
        "summary": "查询翻译任务的源配置",
        "operationId": "get_translation_source_api_v1_translations__request_id__source_get",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Request Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranslationSourceOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DeviceOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "vendor": {
            "type": "string",
            "title": "Vendor"
          },
          "vendor_en": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Vendor En"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "device_type": {
            "$ref": "#/components/schemas/DeviceType"
          }
        },
        "type": "object",
        "required": [
          "id",
          "vendor",
          "model",
          "device_type"
        ],
        "title": "DeviceOut",
        "description": "设备出参。"
      },
      "DeviceType": {
        "type": "string",
        "enum": [
          "switch",
          "firewall"
        ],
        "title": "DeviceType",
        "description": "设备类型。"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "env": {
            "type": "string",
            "title": "Env"
          }
        },
        "type": "object",
        "required": [
          "status",
          "env"
        ],
        "title": "HealthResponse"
      },
      "LoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest",
        "description": "登录入参。"
      },
      "LoginResponse": {
        "properties": {
          "token": {
            "type": "string",
            "title": "Token"
          },
          "user": {
            "$ref": "#/components/schemas/UserOut"
          }
        },
        "type": "object",
        "required": [
          "token",
          "user"
        ],
        "title": "LoginResponse",
        "description": "登录出参：令牌 + 当前用户。"
      },
      "TranslationCreate": {
        "properties": {
          "source_text": {
            "type": "string",
            "maxLength": 2097152,
            "minLength": 1,
            "title": "Source Text"
          },
          "source_vendor": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Source Vendor"
          },
          "source_model": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Source Model"
          },
          "target_vendor": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Target Vendor"
          },
          "target_model": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Target Model"
          }
        },
        "type": "object",
        "required": [
          "source_text",
          "source_vendor",
          "source_model",
          "target_vendor",
          "target_model"
        ],
        "title": "TranslationCreate",
        "description": "创建翻译任务入参。"
      },
      "TranslationCreated": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "status": {
            "$ref": "#/components/schemas/TranslationTaskStatus"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "status"
        ],
        "title": "TranslationCreated",
        "description": "创建翻译任务出参。"
      },
      "TranslationEntityInfo": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          }
        },
        "type": "object",
        "required": [
          "id"
        ],
        "title": "TranslationEntityInfo",
        "description": "结果中引用的规范实体及其说明。"
      },
      "TranslationListItem": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "status": {
            "$ref": "#/components/schemas/TranslationTaskStatus"
          },
          "source_vendor": {
            "type": "string",
            "title": "Source Vendor"
          },
          "source_model": {
            "type": "string",
            "title": "Source Model"
          },
          "target_vendor": {
            "type": "string",
            "title": "Target Vendor"
          },
          "target_model": {
            "type": "string",
            "title": "Target Model"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "status",
          "source_vendor",
          "source_model",
          "target_vendor",
          "target_model",
          "created_at"
        ],
        "title": "TranslationListItem",
        "description": "翻译历史列表项，不含源配置与结果等大字段。"
      },
      "TranslationOut": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "status": {
            "$ref": "#/components/schemas/TranslationTaskStatus"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TranslationResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "status"
        ],
        "title": "TranslationOut",
        "description": "翻译任务查询出参，仅成功时携带结果。"
      },
      "TranslationResult": {
        "properties": {
          "lines": {
            "items": {
              "$ref": "#/components/schemas/TranslationResultLine"
            },
            "type": "array",
            "title": "Lines"
          },
          "warnings": {
            "items": {
              "$ref": "#/components/schemas/TranslationWarning"
            },
            "type": "array",
            "title": "Warnings",
            "default": []
          },
          "entities": {
            "items": {
              "$ref": "#/components/schemas/TranslationEntityInfo"
            },
            "type": "array",
            "title": "Entities",
            "default": []
          },
          "summary": {
            "$ref": "#/components/schemas/TranslationResultSummary"
          }
        },
        "type": "object",
        "required": [
          "lines",
          "summary"
        ],
        "title": "TranslationResult"
      },
      "TranslationResultLine": {
        "properties": {
          "no": {
            "type": "integer",
            "title": "No"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "tone": {
            "type": "string",
            "title": "Tone"
          },
          "source_no": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source No"
          },
          "entity_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Entity Id"
          }
        },
        "type": "object",
        "required": [
          "no",
          "text",
          "tone"
        ],
        "title": "TranslationResultLine"
      },
      "TranslationResultSummary": {
        "properties": {
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "duration_ms": {
            "type": "integer",
            "title": "Duration Ms"
          }
        },
        "type": "object",
        "required": [
          "total",
          "duration_ms"
        ],
        "title": "TranslationResultSummary"
      },
      "TranslationSourceOut": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "source_text": {
            "type": "string",
            "title": "Source Text"
          },
          "source_vendor": {
            "type": "string",
            "title": "Source Vendor"
          },
          "source_model": {
            "type": "string",
            "title": "Source Model"
          },
          "target_vendor": {
            "type": "string",
            "title": "Target Vendor"
          },
          "target_model": {
            "type": "string",
            "title": "Target Model"
          },
          "status": {
            "$ref": "#/components/schemas/TranslationTaskStatus"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "source_text",
          "source_vendor",
          "source_model",
          "target_vendor",
          "target_model",
          "status"
        ],
        "title": "TranslationSourceOut",
        "description": "翻译任务的源配置，用于历史记录恢复。"
      },
      "TranslationTaskStatus": {
        "type": "string",
        "enum": [
          "pending",
          "running",
          "succeeded",
          "failed"
        ],
        "title": "TranslationTaskStatus",
        "description": "翻译任务状态。"
      },
      "TranslationWarning": {
        "properties": {
          "no": {
            "type": "integer",
            "title": "No"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "code": {
            "type": "string",
            "title": "Code",
            "default": "unknown"
          },
          "severity": {
            "type": "string",
            "title": "Severity",
            "default": "warn"
          }
        },
        "type": "object",
        "required": [
          "no",
          "message"
        ],
        "title": "TranslationWarning",
        "description": "行级告警，`no` 为源配置行号。"
      },
      "UserOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "$ref": "#/components/schemas/UserStatus"
          }
        },
        "type": "object",
        "required": [
          "id",
          "username",
          "name",
          "status"
        ],
        "title": "UserOut",
        "description": "用户出参，永不包含密码哈希。"
      },
      "UserStatus": {
        "type": "string",
        "enum": [
          "enabled",
          "disabled"
        ],
        "title": "UserStatus",
        "description": "用户账号状态。"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
